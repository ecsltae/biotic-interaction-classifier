# Joint interaction + direction verifier.
# Modelled on the units that actually run on this box (biotx-community-check.service,
# species-qa.service): uvicorn from the shared venv, config via Environment=, journal logging,
# Restart=always. Install with:
#   sudo cp deploy/metap-verifier.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now metap-verifier
[Unit]
Description=MetaP biotic-interaction triple verifier (interaction + direction)
After=network.target
Wants=network.target

[Service]
Type=simple
User=egaillac
Group=egaillac
WorkingDirectory=/home/egaillac/MetaP/classifier
Environment=VERIFIER_MODEL_DIR=/home/egaillac/MetaP/classifier/models/dirhead/joint_a05_s1
Environment=VERIFIER_THRESHOLD=0.50
Environment=VERIFIER_DIR_ABSTAIN=0.71
Environment=VERIFIER_THREADS=8
Environment=OMP_NUM_THREADS=8
ExecStart=/home/egaillac/MetaP/MPvenv/bin/uvicorn api.verifier_service:app \
    --host 0.0.0.0 \
    --port 8004 \
    --workers 1 \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metap-verifier

[Install]
WantedBy=multi-user.target
