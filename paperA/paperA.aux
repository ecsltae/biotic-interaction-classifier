\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Operating curves on the 437 expert-graded candidates, three-checkpoint ensembles of the models in Table~\ref  {tab:main}. (a)~Precision against recall; markers at $\tau = 0.5$; dotted line, accepting every candidate. The triple-conditioned model is ahead only in the high-precision region and behind at the highest recall. (b)~Precision, recall and F1 of the pair-conditioned model against the decision threshold $\tau $, with the sentence-level model's F1; the shaded band spans the pair-conditioned model's three block-held-out thresholds. The pair-conditioned model is ahead at every one of 99 thresholds, by at least $0.054$ F1. Values at six thresholds: Appendix~\ref  {app:curve}.\relax }}{5}{figure.caption.11}\protected@file@percent }
\newlabel{fig:curves}{{2}{5}{Operating curves on the 437 expert-graded candidates, three-checkpoint ensembles of the models in Table~\ref {tab:main}. (a)~Precision against recall; markers at $\tau = 0.5$; dotted line, accepting every candidate. The triple-conditioned model is ahead only in the high-precision region and behind at the highest recall. (b)~Precision, recall and F1 of the pair-conditioned model against the decision threshold $\tau $, with the sentence-level model's F1; the shaded band spans the pair-conditioned model's three block-held-out thresholds. The pair-conditioned model is ahead at every one of 99 thresholds, by at least $0.054$ F1. Values at six thresholds: Appendix~\ref {app:curve}.\relax }{figure.caption.11}{}}
\newlabel{fig:threshold}{{2}{5}{Operating curves on the 437 expert-graded candidates, three-checkpoint ensembles of the models in Table~\ref {tab:main}. (a)~Precision against recall; markers at $\tau = 0.5$; dotted line, accepting every candidate. The triple-conditioned model is ahead only in the high-precision region and behind at the highest recall. (b)~Precision, recall and F1 of the pair-conditioned model against the decision threshold $\tau $, with the sentence-level model's F1; the shaded band spans the pair-conditioned model's three block-held-out thresholds. The pair-conditioned model is ahead at every one of 99 thresholds, by at least $0.054$ F1. Values at six thresholds: Appendix~\ref {app:curve}.\relax }{figure.caption.11}{}}
