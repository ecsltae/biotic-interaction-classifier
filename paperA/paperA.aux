\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The controlled comparison on 437 rows: one encoder, one corpus, only the input differs. AUPRC is the per-seed mean $\pm $ standard deviation over three seeds; P/R/F1 are three-checkpoint ensembles at block-held-out thresholds. Against the sentence-level model, the pair-conditioned one fixes 75 items and breaks 22 (McNemar $p = 1.3\times 10^{-7}$) and the triple-conditioned one fixes 74 and breaks 32 ($p = 6.8\times 10^{-5}$); triple against pair, 20 fixed and 31 broken ($p = 0.16$). Per-seed values are in Appendix~\ref  {app:seeds}.\relax }}{4}{table.caption.10}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:main}{{1}{4}{The controlled comparison on 437 rows: one encoder, one corpus, only the input differs. AUPRC is the per-seed mean $\pm $ standard deviation over three seeds; P/R/F1 are three-checkpoint ensembles at block-held-out thresholds. Against the sentence-level model, the pair-conditioned one fixes 75 items and breaks 22 (McNemar $p = 1.3\times 10^{-7}$) and the triple-conditioned one fixes 74 and breaks 32 ($p = 6.8\times 10^{-5}$); triple against pair, 20 fixed and 31 broken ($p = 0.16$). Per-seed values are in Appendix~\ref {app:seeds}.\relax }{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Where the gain lives, AUPRC of the three ensembles. Taxa are counted as distinct mentions found in the passage by TaxoNERD \citep  {leguillarme2022taxonerd} (\texttt  {en\_ner\_eco\_biobert}); an argument ``is not a taxon'' when TaxoNERD does not recognise it in the passage. \textsc  {Test299} passages name $5.1$ taxa on average, \textsc  {Biotx100} $2.6$ and \textsc  {Reject50} $1.7$.\relax }}{4}{table.caption.11}\protected@file@percent }
\newlabel{tab:where}{{2}{4}{Where the gain lives, AUPRC of the three ensembles. Taxa are counted as distinct mentions found in the passage by TaxoNERD \citep {leguillarme2022taxonerd} (\texttt {en\_ner\_eco\_biobert}); an argument ``is not a taxon'' when TaxoNERD does not recognise it in the passage. \textsc {Test299} passages name $5.1$ taxa on average, \textsc {Biotx100} $2.6$ and \textsc {Reject50} $1.7$.\relax }{table.caption.11}{}}
