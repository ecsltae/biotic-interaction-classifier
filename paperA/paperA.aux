\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Exact values of Figure~\ref  {fig:where} (biodiversity rows) and AUPRC by source block; all values are AUPRC of three-checkpoint ensembles. Taxa are counted as distinct mentions found in the passage by TaxoNERD \citep  {leguillarme2022taxonerd} (\texttt  {en\_ner\_eco\_biobert}); an argument ``is not a taxon'' when TaxoNERD does not recognise it in the passage. \textsc  {Test299} passages name $5.1$ taxa on average, \textsc  {Biotx100} $2.6$ and \textsc  {Reject50} $1.7$.\relax }}{14}{table.caption.38}\protected@file@percent }
\newlabel{tab:where}{{4}{14}{Exact values of Figure~\ref {fig:where} (biodiversity rows) and AUPRC by source block; all values are AUPRC of three-checkpoint ensembles. Taxa are counted as distinct mentions found in the passage by TaxoNERD \citep {leguillarme2022taxonerd} (\texttt {en\_ner\_eco\_biobert}); an argument ``is not a taxon'' when TaxoNERD does not recognise it in the passage. \textsc {Test299} passages name $5.1$ taxa on average, \textsc {Biotx100} $2.6$ and \textsc {Reject50} $1.7$.\relax }{table.caption.38}{}}
